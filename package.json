{
  "name": "quire",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reader": "node scripts/bundle-reader.mjs",
    "android": "node scripts/bundle-reader.mjs && expo run:android --app-id app.quire.reader.dev",
    "apk": "node scripts/build-apk.mjs",
    "serve-books": "node scripts/serve-books.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/domain/*.test.ts src/renderer/*.test.ts src/debug/*.test.ts",
    "fixtures": "node scripts/build-fixtures.mjs",
    "books": "node scripts/download-test-books.mjs",
    "phone-matrix": "node scripts/phone-matrix.mjs"
  }
}
